# Deny new runtime files by default. Review each new public path explicitly.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/config.example.toml
!/agents/
/agents/*
!/agents/*.toml
!/guides/
/guides/*
!/guides/*.md
!/skills/
/skills/*
!/skills/plan-work/
!/skills/frontend-design/
!/skills/playwright/
!/skills/tdd/
!/setup/
/setup/*
!/setup/hooks.example.json
!/setup/rtk.config.toml

# These remain private even inside an allowed directory.
**/.env
**/.env.*
**/auth.json
**/credentials.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/__pycache__/
**/*.py[cod]
**/node_modules/
**/.venv/
**/.DS_Store
**/*.sqlite*
**/*.db
**/*.log
**/*.backup*
**/*.before-codex-setup
**/output/
**/test-results/
**/playwright-report/
